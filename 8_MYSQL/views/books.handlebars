<div class="nav-container">
    <nav>
        <ul>
            <li><a href="/">Cadastrar livro</a></li>
            <li><a href="/books">Listar livros</a></li>
        </ul>
    </nav>
</div>
<div class="container">
    <h1>Livros disponíveis:</h1>
    <div class="books-container">
        {{#each books}}
        <div>#{{this.idbooks}} - <span class="bold"><a href="/books/{{this.idbooks}}">{{this.title}}</a></span>
            - {{this.pageqty}} páginas
        </div>
        {{/each}}
    </div>
</div>